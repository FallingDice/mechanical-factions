type: mech
speed: 2
health: 60
hitSize: 8
riseSpeed: 0.2

useUnitCap: false

crashDamageMultiplier: 1.5

deathExplosionEffect: sapExplosion
createScorch: false

parts: [
            {
            type: RegionPart
            progress: warmup
            linearWarmup: true
            minWarmup: 1
            shootWarmupSpeed: 0.001
            smoothReloadSpeed: 0.001
            suffix: -reactor
            mirror: false
            y: 1
            moveX: 0
            moveY: -2
            moveRot: 0
            growX: 0.3
            growY: 0.3
            layerOffset: -0.01
            heatLayerOffset: 0.05
          },
          {
            type: RegionPart
            progress: warmup
            suffix: -reactor
            mirror: true
            x: 0
            y: -1
            moveX: 3
            moveY: 1
            moveRot: 90
            layerOffset: -0.02
            heatLayerOffset: 0.05
          }
]

weapons: [
    {
        rotate: true
        mirror: false
        x: 0
        y: 0
        reload: 0
        ejectEffect: casing1
        shootSound: shootAfflict
        shootOnDeath: true
        shoot: {
          firstShotDelay: 80
        }
        cooldownTime: 60

        bullet: {
            type: ArtilleryBulletType
            splashDamageRadius: 10
            splashDamage: 5
            damage: 15
            speed: 6
            width: 10
            height: 10
            lifetime: 30
            knockback: 5
            collides: true
            collidesTiles: true

            trailWidth: 13
            trailLength: 2
            trailInterp: slope

            shrinkX: 0.8
            shrinkY: 0.1

            despawnUnit: mechanical-striker
            killShooter: true
            
            shootEffect: shootSmokeSquare
            smokeEffect: shootSmokeDisperse
            hitEffect: hitBulletColor
            despawnEffect: spawn
            despawnSound: boom
        }
    }
]

abilities: [
    {
        type: MoveEffectAbility
        minVelocity: 1
        x: 0
        y: -0.4
        effect: artilleryTrailSmoke
        teamColor: true
        interval: 10
    },
    {
        type: RegenAbility
        amount: 0.1
    }
]

research: mechanical-groundfactory
researchCostMultiplier: 3
